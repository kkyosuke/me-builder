{
  "openapi": "3.1.0",
  "info": {
    "title": "me-builder API",
    "description": "me-builder Web UIが利用するHTTP API契約",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "liffIdToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "LIFF ID token"
      }
    }
  },
  "paths": {
    "/api/line/liff/session": {
      "post": {
        "operationId": "verifyLiffSession",
        "tags": ["LIFF"],
        "summary": "LIFF IDトークンを検証してAccountを解決する",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idToken": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["idToken"],
                "$schema": "http://json-schema.org/draft-07/schema#"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "表示可能なLINEプロフィール",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "displayName": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pictureUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": []
                }
              }
            }
          },
          "401": {
            "description": "LIFF IDトークンを検証できない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Unauthorized"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "404": {
            "description": "対応するAccountが存在しない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Account not found"
                    },
                    "reason": {
                      "const": "friendship_required"
                    }
                  },
                  "required": ["error", "reason"]
                }
              }
            }
          },
          "500": {
            "description": "未処理のサーバーエラー",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Internal Server Error"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "503": {
            "description": "D1 bindingが設定されていない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Service Unavailable"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/api/surveys": {
      "get": {
        "operationId": "listSurveys",
        "tags": ["Survey"],
        "summary": "回答進捗を含むアンケート一覧を取得する",
        "security": [
          {
            "liffIdToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "アンケート一覧",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "surveys": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "title": {
                            "type": "string",
                            "minLength": 1
                          },
                          "description": {
                            "type": "string",
                            "minLength": 1
                          },
                          "opensAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "closesAt": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date-time"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "availability": {
                            "enum": ["open", "closed"],
                            "type": "string"
                          },
                          "responseStatus": {
                            "enum": ["unanswered", "in-progress", "answered"],
                            "type": "string"
                          },
                          "answeredCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "questionCount": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "id",
                          "title",
                          "description",
                          "opensAt",
                          "closesAt",
                          "availability",
                          "responseStatus",
                          "answeredCount",
                          "questionCount"
                        ]
                      }
                    }
                  },
                  "required": ["surveys"]
                }
              }
            }
          },
          "401": {
            "description": "LIFF IDトークンを検証できない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Unauthorized"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "404": {
            "description": "対応するAccountが存在しない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Account not found"
                    },
                    "reason": {
                      "const": "friendship_required"
                    }
                  },
                  "required": ["error", "reason"]
                }
              }
            }
          },
          "500": {
            "description": "未処理のサーバーエラー",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Internal Server Error"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "503": {
            "description": "D1 bindingが設定されていない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Service Unavailable"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/api/surveys/{surveyId}": {
      "get": {
        "operationId": "getSurveyDetail",
        "tags": ["Survey"],
        "summary": "新規回答用のアンケート詳細を取得する",
        "security": [
          {
            "liffIdToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Question VersionとChoiceを含むアンケート詳細",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "opensAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "closesAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "questions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "surveyQuestionId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "questionId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "questionVersion": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1
                          },
                          "hint": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "choices": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "choiceId": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "label": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "presentation": {
                                  "type": "object",
                                  "propertyNames": {
                                    "type": "string"
                                  },
                                  "additionalProperties": {
                                    "type": "string"
                                  }
                                }
                              },
                              "required": ["choiceId", "label", "presentation"]
                            },
                            "minItems": 2
                          }
                        },
                        "required": [
                          "surveyQuestionId",
                          "questionId",
                          "questionVersion",
                          "text",
                          "hint",
                          "choices"
                        ]
                      },
                      "minItems": 1
                    }
                  },
                  "required": ["id", "title", "description", "opensAt", "closesAt", "questions"]
                }
              }
            }
          },
          "401": {
            "description": "LIFF IDトークンを検証できない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Unauthorized"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "404": {
            "description": "対応するAccountがない、またはSurveyが公開されていない",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "const": "Account not found"
                        },
                        "reason": {
                          "const": "friendship_required"
                        }
                      },
                      "required": ["error", "reason"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "const": "Survey not found"
                        },
                        "reason": {
                          "const": "survey_not_found"
                        }
                      },
                      "required": ["error", "reason"]
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Surveyの受付が終了している",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Survey closed"
                    },
                    "reason": {
                      "const": "survey_closed"
                    }
                  },
                  "required": ["error", "reason"]
                }
              }
            }
          },
          "500": {
            "description": "未処理のサーバーエラー",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Internal Server Error"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "503": {
            "description": "D1 bindingが設定されていない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Service Unavailable"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "surveyId",
            "required": true
          }
        ]
      }
    }
  }
}
