{
  "openapi": "3.1.0",
  "info": {
    "title": "me-builder API",
    "description": "me-builder Web UIが利用するHTTP API契約",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "liffIdToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "LIFF ID token"
      }
    }
  },
  "paths": {
    "/api/line/liff/session": {
      "post": {
        "operationId": "verifyLiffSession",
        "tags": ["LIFF"],
        "summary": "LIFF IDトークンを検証してAccountを解決する",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "idToken": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": ["idToken"],
                "$schema": "http://json-schema.org/draft-07/schema#"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "表示可能なLINEプロフィール",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "displayName": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pictureUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": []
                }
              }
            }
          },
          "401": {
            "description": "LIFF IDトークンを検証できない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Unauthorized"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "404": {
            "description": "対応するAccountが存在しない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Account not found"
                    },
                    "reason": {
                      "const": "friendship_required"
                    }
                  },
                  "required": ["error", "reason"]
                }
              }
            }
          },
          "500": {
            "description": "未処理のサーバーエラー",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Internal Server Error"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "503": {
            "description": "D1 bindingが設定されていない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Service Unavailable"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/api/surveys": {
      "get": {
        "operationId": "listSurveys",
        "tags": ["Survey"],
        "summary": "回答進捗を含むアンケート一覧を取得する",
        "security": [
          {
            "liffIdToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "アンケート一覧",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "surveys": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "title": {
                            "type": "string",
                            "minLength": 1
                          },
                          "description": {
                            "type": "string",
                            "minLength": 1
                          },
                          "opensAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "closesAt": {
                            "anyOf": [
                              {
                                "type": "string",
                                "format": "date-time"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "availability": {
                            "enum": ["open", "closed"],
                            "type": "string"
                          },
                          "responseStatus": {
                            "enum": ["unanswered", "in-progress", "answered"],
                            "type": "string"
                          },
                          "answeredCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "questionCount": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "id",
                          "title",
                          "description",
                          "opensAt",
                          "closesAt",
                          "availability",
                          "responseStatus",
                          "answeredCount",
                          "questionCount"
                        ]
                      }
                    }
                  },
                  "required": ["surveys"]
                }
              }
            }
          },
          "401": {
            "description": "LIFF IDトークンを検証できない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Unauthorized"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "404": {
            "description": "対応するAccountが存在しない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Account not found"
                    },
                    "reason": {
                      "const": "friendship_required"
                    }
                  },
                  "required": ["error", "reason"]
                }
              }
            }
          },
          "500": {
            "description": "未処理のサーバーエラー",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Internal Server Error"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "503": {
            "description": "D1 bindingが設定されていない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Service Unavailable"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/api/surveys/{surveyId}": {
      "get": {
        "operationId": "getSurveyDetail",
        "tags": ["Survey"],
        "summary": "新規回答用のアンケート詳細を取得する",
        "security": [
          {
            "liffIdToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Question VersionとChoiceを含むアンケート詳細",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "opensAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "closesAt": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date-time"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "questions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "surveyQuestionId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "questionId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "questionVersion": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "text": {
                            "type": "string",
                            "minLength": 1
                          },
                          "hint": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "choices": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "choiceId": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "label": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "presentation": {
                                  "type": "object",
                                  "propertyNames": {
                                    "type": "string"
                                  },
                                  "additionalProperties": {
                                    "type": "string"
                                  }
                                }
                              },
                              "required": ["choiceId", "label", "presentation"]
                            },
                            "minItems": 2
                          }
                        },
                        "required": [
                          "surveyQuestionId",
                          "questionId",
                          "questionVersion",
                          "text",
                          "hint",
                          "choices"
                        ]
                      },
                      "minItems": 1
                    }
                  },
                  "required": ["id", "title", "description", "opensAt", "closesAt", "questions"]
                }
              }
            }
          },
          "401": {
            "description": "LIFF IDトークンを検証できない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Unauthorized"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "404": {
            "description": "対応するAccountがない、またはSurveyが公開されていない",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "const": "Account not found"
                        },
                        "reason": {
                          "const": "friendship_required"
                        }
                      },
                      "required": ["error", "reason"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "const": "Survey not found"
                        },
                        "reason": {
                          "const": "survey_not_found"
                        }
                      },
                      "required": ["error", "reason"]
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Surveyの受付が終了している",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Survey closed"
                    },
                    "reason": {
                      "const": "survey_closed"
                    }
                  },
                  "required": ["error", "reason"]
                }
              }
            }
          },
          "500": {
            "description": "未処理のサーバーエラー",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Internal Server Error"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "503": {
            "description": "D1 bindingが設定されていない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Service Unavailable"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "surveyId",
            "required": true
          }
        ]
      }
    },
    "/api/surveys/{surveyId}/answers": {
      "get": {
        "operationId": "getSurveyAnswers",
        "tags": ["Survey"],
        "summary": "本人が保存したアンケート回答内容を取得する",
        "security": [
          {
            "liffIdToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "質問文・選択肢・回答日時を含む本人の回答内容",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1
                    },
                    "responseStatus": {
                      "enum": ["in-progress", "answered"],
                      "type": "string"
                    },
                    "answeredCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "questionCount": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "answers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "surveyQuestionId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "questionId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "questionVersion": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "questionText": {
                            "type": "string",
                            "minLength": 1
                          },
                          "choiceId": {
                            "type": "string",
                            "minLength": 1
                          },
                          "choiceLabel": {
                            "type": "string",
                            "minLength": 1
                          },
                          "acceptedAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        },
                        "required": [
                          "surveyQuestionId",
                          "questionId",
                          "questionVersion",
                          "questionText",
                          "choiceId",
                          "choiceLabel",
                          "acceptedAt"
                        ]
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "description",
                    "responseStatus",
                    "answeredCount",
                    "questionCount",
                    "answers"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "LIFF IDトークンを検証できない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Unauthorized"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "404": {
            "description": "対応するAccount、Survey、または回答がない",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "const": "Account not found"
                        },
                        "reason": {
                          "const": "friendship_required"
                        }
                      },
                      "required": ["error", "reason"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "const": "Survey answers not found"
                        },
                        "reason": {
                          "const": "survey_answers_not_found"
                        }
                      },
                      "required": ["error", "reason"]
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "未処理のサーバーエラー",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Internal Server Error"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "503": {
            "description": "D1 bindingが設定されていない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Service Unavailable"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "surveyId",
            "required": true
          }
        ]
      }
    },
    "/api/surveys/{surveyId}/answers/{surveyQuestionId}": {
      "put": {
        "operationId": "saveSurveyAnswer",
        "tags": ["Survey"],
        "summary": "アンケートの1問へ初回回答を保存する",
        "security": [
          {
            "liffIdToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "kind": "schema",
                "type": "object",
                "expects": "Object",
                "async": false,
                "entries": {
                  "choiceId": {
                    "kind": "schema",
                    "type": "string",
                    "expects": "string",
                    "async": false,
                    "~standard": {
                      "version": 1,
                      "vendor": "valibot"
                    },
                    "pipe": [
                      {
                        "kind": "schema",
                        "type": "string",
                        "expects": "string",
                        "async": false,
                        "~standard": {
                          "version": 1,
                          "vendor": "valibot"
                        }
                      },
                      {
                        "kind": "validation",
                        "type": "non_empty",
                        "async": false,
                        "expects": "!0"
                      }
                    ]
                  }
                },
                "~standard": {
                  "version": 1,
                  "vendor": "valibot"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "保存済み回答と現在の進捗",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "outcome": {
                      "enum": ["created", "unchanged"],
                      "type": "string"
                    },
                    "answer": {
                      "type": "object",
                      "properties": {
                        "surveyQuestionId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "questionId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "questionVersion": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        "choiceId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "acceptedAt": {
                          "type": "string",
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "surveyQuestionId",
                        "questionId",
                        "questionVersion",
                        "choiceId",
                        "acceptedAt"
                      ]
                    },
                    "progress": {
                      "type": "object",
                      "properties": {
                        "responseStatus": {
                          "enum": ["unanswered", "in-progress", "answered"],
                          "type": "string"
                        },
                        "answeredCount": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "questionCount": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": ["responseStatus", "answeredCount", "questionCount"]
                    }
                  },
                  "required": ["outcome", "answer", "progress"]
                }
              }
            }
          },
          "400": {
            "description": "リクエストJSONが不正",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Invalid request"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "401": {
            "description": "LIFF IDトークンを検証できない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Unauthorized"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "404": {
            "description": "対応するAccountがない、またはSurveyが公開されていない",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "const": "Account not found"
                        },
                        "reason": {
                          "const": "friendship_required"
                        }
                      },
                      "required": ["error", "reason"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "const": "Survey not found"
                        },
                        "reason": {
                          "const": "survey_not_found"
                        }
                      },
                      "required": ["error", "reason"]
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "受付終了、または回答修正が必要",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "const": "Survey closed"
                        },
                        "reason": {
                          "const": "survey_closed"
                        }
                      },
                      "required": ["error", "reason"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "error": {
                          "const": "Answer already exists"
                        },
                        "reason": {
                          "const": "answer_change_requires_revision"
                        }
                      },
                      "required": ["error", "reason"]
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Survey QuestionまたはChoiceが不正",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Invalid answer"
                    },
                    "reason": {
                      "enum": ["survey_question_not_found", "choice_not_found"],
                      "type": "string"
                    }
                  },
                  "required": ["error", "reason"]
                }
              }
            }
          },
          "500": {
            "description": "未処理のサーバーエラー",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Internal Server Error"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "503": {
            "description": "D1 bindingが設定されていない",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "const": "Service Unavailable"
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "surveyId",
            "required": true
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "surveyQuestionId",
            "required": true
          }
        ]
      }
    }
  }
}
