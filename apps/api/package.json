{
  "name": "@me-builder/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:wrangler": "wrangler dev --env local",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "generate:openapi": "bun scripts/generate-openapi.ts && biome format --write openapi.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir .",
    "test:e2e": "vitest run --dir src/e2e",
    "register:webhook": "bun scripts/register-webhook.ts",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@hono/standard-validator": "0.3.0",
    "@me-builder/lib": "workspace:*",
    "@me-builder/shared": "workspace:*",
    "@valibot/to-json-schema": "1.7.1",
    "hono": "^4.4.0",
    "hono-openapi": "1.3.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.38.4",
    "miniflare": "4.20260722.0"
  }
}
