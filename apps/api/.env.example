# サーバー環境設定
PORT=3000
ENVIRONMENT=local # local | preview | production

# ドメインおよびベースURL設定
BASE_DOMAIN=stg.kagami.kyosuke.dev # 指定時、BASE_URL は https://api.stg.kagami.kyosuke.dev に自動補完されます
BASE_URL=https://api.stg.kagami.kyosuke.dev

# LINE Messaging API 設定
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_WEBHOOK_URL=https://api.stg.kagami.kyosuke.dev/api/line/webhook
# リッチメニューから開くLIFFアプリのID
LIFF_ID=your_liff_id

# LINE Webhook の x-line-signature 検証に使用するチャネルシークレット (必須)
# (LINE Developers コンソール > チャネル基本設定 > チャネルシークレット)
# 未設定の場合、環境を問わず全ての Webhook リクエストを 401 で拒否します。
LINE_CHANNEL_SECRET=your_line_channel_secret

# 管理者のLINE user IDをカンマ区切りで指定します。リポジトリへ実値をコミットしないでください。
ADMIN_LINE_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 外部ブラウザSSO (Auth0 Regular Web Application)
# LocalはPreview tenant内のLocal専用clientを使います。実値やSecretをコミットしないでください。
SSO_ISSUER_URL=https://your-preview-tenant.jp.auth0.com/
SSO_CLIENT_ID=your_local_auth0_client_id
SSO_CLIENT_SECRET=your_local_auth0_client_secret
SSO_ROLLOUT_MODE=disabled # disabled | linking | linked-login
