# サーバー環境設定
PORT=3000
ENVIRONMENT=local # local | preview | production

# ドメインおよびベースURL設定
BASE_URL=http://localhost:3000
# credential付きCORSとSSO callback後の復帰先に使う完全一致origin
WEB_ORIGIN=http://localhost:5173

# LINE Messaging API 設定
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_WEBHOOK_URL=https://api.stg.kagami.kyosuke.dev/api/line/webhook
# リッチメニューから開くLIFFアプリのID
LIFF_ID=your_liff_id

# LINE Webhook の x-line-signature 検証に使用するチャネルシークレット (必須)
# (LINE Developers コンソール > チャネル基本設定 > チャネルシークレット)
# 未設定の場合、環境を問わず全ての Webhook リクエストを 401 で拒否します。
LINE_CHANNEL_SECRET=your_line_channel_secret

# 管理者のLINE user IDをカンマ区切りで指定します。リポジトリへ実値をコミットしないでください。
ADMIN_LINE_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 外部ブラウザSSO (Google Cloud Identity Platform)
# LocalはPreviewと同じDevelopment project／OAuth clientを使います。
# OAuth clientには http://localhost:3000/api/auth/sso/callback を登録してください。
# 実値やSecretをコミットしないでください。
GOOGLE_IDENTITY_PLATFORM_API_KEY=your_development_identity_platform_api_key
GOOGLE_OAUTH_CLIENT_ID=your_development_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_development_google_oauth_client_secret
SSO_ROLLOUT_MODE=disabled # disabled | linking | linked-login
SSO_ROLLOUT_PERCENT=0 # 0: admin only | 1-99: stable linked cohort | 100: all linked accounts
