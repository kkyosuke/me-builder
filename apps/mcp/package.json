{
  "name": "@me-builder/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:wrangler": "wrangler dev --env local",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir .",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@google/genai": "2.15.0",
    "@me-builder/lib": "workspace:*",
    "@me-builder/shared": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "hono": "^4.13.1",
    "valibot": "^1.4.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260724.1",
    "@types/bun": "latest"
  }
}
