# Web UI 環境設定
VITE_ENVIRONMENT=local # local | preview | production

# ベースドメイン設定
VITE_BASE_DOMAIN=stg.kagami.kyosuke.dev # 指定時、VITE_BASE_URL は https://stg.kagami.kyosuke.dev、VITE_API_URL は https://api.stg.kagami.kyosuke.dev に自動補完されます
VITE_BASE_URL=https://stg.kagami.kyosuke.dev
VITE_API_URL=https://api.stg.kagami.kyosuke.dev

# LIFF 設定
# LINE Developers コンソールの LINE Login チャネルで作成した LIFF アプリの LIFF ID
# 未設定の場合、LIFF の初期化はスキップされ LIFF なしの画面が表示されます
VITE_LIFF_ID=
