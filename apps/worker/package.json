{
  "name": "@me-builder/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:wrangler": "wrangler dev --env local",
    "build": "bun build src/index.ts --outdir ./dist --target bun --external cloudflare:workers --loader .sql:text",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir .",
    "db:generate": "drizzle-kit generate && biome check --write --unsafe drizzle",
    "check:gemini": "bun scripts/check-gemini.ts",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@me-builder/lib": "workspace:*",
    "@me-builder/shared": "workspace:*",
    "drizzle-orm": "^0.38.4",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "better-sqlite3": "^13.0.1",
    "drizzle-kit": "^0.30.2",
    "miniflare": "4.20260722.0"
  }
}
