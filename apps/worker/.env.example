# Vertex AI Express Mode (Gemini) の直接接続設定
GOOGLE_VERTEX_AI_API_KEY=your_google_vertex_ai_api_key
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
# LINE pushのX-Line-Retry-Keyを決定的に生成する環境別Secret
CHAT_DELIVERY_SECRET=replace_with_a_random_secret
# Brain Itemのvector IDとAccount scopeを仮名化する環境別Secret
BRAIN_VECTOR_HMAC_SECRET=replace_with_another_random_secret
# Geminiへ渡す直近message件数
CHAT_CONTEXT_MESSAGE_LIMIT=20
ADMIN_LINE_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 環境ごとにモデルを変える場合だけ指定します。
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
