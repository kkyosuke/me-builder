# Cloudflare AI Gateway 経由の Google AI Studio (Gemini) 接続設定
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_api_key
CLOUDFLARE_APP_API_TOKEN=your_cloudflare_app_token
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
# LINE pushのX-Line-Retry-Keyを決定的に生成する環境別Secret
CHAT_DELIVERY_SECRET=replace_with_a_random_secret
# Geminiへ渡す直近message件数
CHAT_CONTEXT_MESSAGE_LIMIT=20
ADMIN_LINE_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 通常は既定値のままで利用できます。環境ごとに Gateway やモデルを変える場合だけ指定します。
CF_AI_GATEWAY_BASE_URL=https://gateway.ai.cloudflare.com/v1/8e0b10ee5263d2f699a93dbe3ee97da0/default/google-ai-studio
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
