{
  "name": "@me-builder/lib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./line": "./src/line/index.ts",
    "./line/liff-configuration": "./src/line/configuration.ts",
    "./d1": "./src/d1/index.ts",
    "./do": "./src/do/index.ts",
    "./diagnosis": "./src/diagnosis/index.ts",
    "./diagnosis/relationship-category": "./src/diagnosis/relationship-category.ts",
    "./compatibility": "./src/compatibility/index.ts",
    "./billing/plan-capability": "./src/billing/plan-capability.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir .",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --env preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file=seeds/diagnoses.sql",
    "db:seed:preview": "wrangler d1 execute DB --env preview --remote --file=seeds/diagnoses.sql",
    "db:seed:production": "wrangler d1 execute DB --env production --remote --file=seeds/diagnoses.sql"
  },
  "dependencies": {
    "@line/bot-sdk": "^11.2.0",
    "@me-builder/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "stripe": "^22.5.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "better-sqlite3": "^13.0.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.4.5"
  }
}
