{
  "name": "@me-builder/lib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./line": "./src/line/index.ts",
    "./d1": "./src/d1/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir .",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate:local": "wrangler d1 migrations apply me-builder-db-local --local --path ./drizzle",
    "db:migrate:preview": "wrangler d1 migrations apply me-builder-db-preview --remote --path ./drizzle",
    "db:migrate:production": "wrangler d1 migrations apply me-builder-db-production --remote --path ./drizzle"
  },
  "dependencies": {
    "@line/bot-sdk": "^11.2.0",
    "@me-builder/shared": "workspace:*",
    "drizzle-orm": "^0.38.4",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "better-sqlite3": "^13.0.1",
    "drizzle-kit": "^0.30.2",
    "typescript": "^5.4.5"
  }
}
