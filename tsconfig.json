{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    // 前回の型チェック結果 (`<パッケージ>/tsconfig.tsbuildinfo`) を再利用する。
    // CI では GitHub Actions のキャッシュから復元し、変更が無いパッケージの再チェックを省く。
    "incremental": true
  }
}
