{
  "name": "me-builder",
  "private": true,
  "workspaces": ["apps/*", "infra", "packages/*"],
  "overrides": {
    "esbuild": "0.25.12",
    "fast-uri": "3.1.5",
    "ip-address": "10.5.0",
    "js-yaml": "4.3.1",
    "markdown-it": "14.2.0",
    "smol-toml": "1.6.1",
    "tar": "7.5.22",
    "undici": "7.29.0"
  },
  "scripts": {
    "dev": "bun --filter '*' dev",
    "build": "bun --filter '*' build",
    "generate:api": "bun --cwd apps/api generate:openapi && bun --cwd apps/web generate:api",
    "check:generated": "bun --cwd infra check:wrangler && bun run generate:api && git diff --exit-code -- apps/api/openapi.json apps/web/src/generated/api.ts",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "audit": "bun audit",
    "test": "vitest run && bun --filter @me-builder/worker test:runtime",
    "test:unit": "vitest run --exclude '**/{e2e/**,runtime-e2e/**,*.e2e.test.*}'",
    "test:e2e": "vitest run --dir . e2e && bun --filter @me-builder/worker test:runtime",
    "test:pre-push": "bun run test:unit",
    "ci": "bun run audit && bun run check:generated && bun run lint && bun run lint:exports && bun run lint:md && bun run typecheck && bun run test && bun run build",
    "task": "task",
    "deploy:preview": "bun --filter '*' deploy:preview",
    "deploy:production": "bun --filter '*' deploy:production",
    "lint:exports": "knip",
    "lint:md": "markdownlint-cli2 '**/*.md' '#**/node_modules/**' '#**/.bun/**' '#**/dist/**' '#**/.claude/**'",
    "lint:md:links": "find . -name '*.md' -not -path '*/node_modules/*' -not -path '*/.bun/*' -print0 | xargs -0 markdown-link-check -q -c mlc_config.json",
    "lint:md:links:relative": "find . -name '*.md' -not -path '*/node_modules/*' -not -path '*/.bun/*' -print0 | xargs -0 markdown-link-check -q -c mlc_config.relative.json",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@go-task/cli": "^3.52.0",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli2": "0.22.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.121.0"
  }
}
