{
  "name": "me-builder",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "build": "bun --filter '*' build",
    "generate:api": "bun --cwd apps/api generate:openapi && bun --cwd apps/web generate:api",
    "check:generated": "bun run generate:api && git diff --exit-code -- apps/api/openapi.json apps/web/src/generated/api.ts",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run && bun --filter @me-builder/worker test:runtime",
    "test:pre-push": "vitest run --exclude '**/{e2e/**,runtime-e2e/**,*.e2e.test.*}'",
    "ci": "bun run check:generated && bun run lint && bun run typecheck && bun run test && bun run build",
    "task": "task",
    "deploy:preview": "bun --filter '*' deploy:preview",
    "deploy:production": "bun --filter '*' deploy:production",
    "lint:exports": "knip",
    "lint:md": "markdownlint-cli2 '**/*.md' '#**/node_modules/**' '#**/.bun/**' '#**/dist/**' '#**/.claude/**'",
    "lint:md:links": "find . -name '*.md' -not -path '*/node_modules/*' -not -path '*/.bun/*' -exec markdown-link-check -q -c mlc_config.json {} \\;",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@go-task/cli": "^3.52.0",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "markdown-link-check": "^3.14.2",
    "markdownlint-cli2": "^0.23.1",
    "tsx": "^4.23.11",
    "typescript": "^5.4.5",
    "vitest": "^4.1.0",
    "wrangler": "^4.114.0"
  }
}
