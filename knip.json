{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["apps/web/src/generated/**"],
  "ignoreDependencies": ["cloudflare", "lightningcss", "markdown-link-check"],
  "workspaces": {
    "infra": {
      "entry": ["index.ts", "gcp-platform/index.ts", "scripts/*.ts", "src/cleanup-worker.ts"]
    },
    "apps/worker": {
      "entry": [
        "src/**/*.test.ts",
        "src/account-data/drizzle-schema.ts",
        "src/compatibility-data/schema.ts",
        "drizzle*.config.ts"
      ]
    }
  }
}
